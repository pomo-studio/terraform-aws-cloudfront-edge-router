${routing_code}

async function handler(event) {
  const response = event.response;
  const state = await readState();
  if (!state.pinCookie) {
    return response;
  }
  // Viewer-response receives the original viewer request. Reproduce the
  // choice from its request ID instead of trusting a mutated request header.
  const deployment = pickDeployment(event.request, state, event.context.requestId);
  const current = (event.request.cookies || {})[state.pinCookie];
  if (!current || current.value !== deployment) {
    response.cookies = response.cookies || {};
    response.cookies[state.pinCookie] = {
      value: deployment,
      attributes: 'Path=/; Secure; SameSite=Lax; Max-Age=86400',
    };
  }
  return response;
}